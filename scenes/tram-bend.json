{
      "formatVersion": 1,
      "id": "tram-bend",
      "title": "The Late Tram",
      "intro": "One more stop and you are home. The driver has just opened a coffee.",
      "durationSeconds": 10,
      "maxTouches": 2,
      "grid": { "columns": 6, "rows": 4 },
      "objects": [
        {
          "id": "driver",
          "label": "Driver",
          "position": { "x": 5, "y": 0 },
          "initialState": "sipping",
          "states": {
            "sipping": { "emoji": "🧑‍✈️" },
            "distracted": { "emoji": "📱" },
            "alert": { "emoji": "🫡" }
          }
        },
        {
          "id": "tram",
          "label": "Tram",
          "position": { "x": 3, "y": 0 },
          "initialState": "running",
          "states": {
            "running": { "emoji": "🚋" },
            "speeding": { "emoji": "💨" },
            "slowing": { "emoji": "🐢" },
            "derailed": { "emoji": "💥" }
          }
        },
        {
          "id": "brake",
          "label": "Brake",
          "position": { "x": 4, "y": 2 },
          "initialState": "ready",
          "states": {
            "ready": { "emoji": "🔴" },
            "pulled": { "emoji": "🛑" }
          }
        },
        {
          "id": "suitcase",
          "label": "Suitcase",
          "position": { "x": 1, "y": 2 },
          "initialState": "parked",
          "states": {
            "parked": { "emoji": "🧳" },
            "rolling": { "emoji": "🛞" },
            "stopped": { "emoji": "🧳" },
            "flying": { "emoji": "🚀" }
          }
        },
        {
          "id": "door",
          "label": "Door",
          "position": { "x": 2, "y": 3 },
          "initialState": "closed",
          "states": {
            "closed": { "emoji": "🚪" },
            "jammed_open": { "emoji": "🌬️" }
          }
        },
        {
          "id": "dog",
          "label": "Dog",
          "position": { "x": 0, "y": 3 },
          "initialState": "asleep",
          "states": {
            "asleep": { "emoji": "😴" },
            "sniffing": { "emoji": "🐕" },
            "calm": { "emoji": "🥰" },
            "gone": { "emoji": "💨" }
          }
        }
      ],
      "touches": [
        {
          "id": "tap-driver",
          "object": "driver",
          "when": [{ "object": "driver", "state": "distracted" }],
          "then": [{ "object": "driver", "state": "alert" }],
          "caption": "You tap the driver on the shoulder. Eyes back on the track."
        },
        {
          "id": "pull-brake-at-speed",
          "object": "brake",
          "when": [{ "object": "tram", "state": "speeding" }],
          "then": [
            { "object": "brake", "state": "pulled" },
            { "object": "tram", "state": "slowing" }
          ],
          "caption": "You pull the brake just in time."
        },
        {
          "id": "pull-brake-too-early",
          "object": "brake",
          "when": [{ "object": "brake", "state": "ready" }],
          "then": [
            { "object": "brake", "state": "pulled" },
            { "object": "suitcase", "state": "flying" }
          ],
          "caption": "The tram lurches and the suitcase takes off."
        },
        {
          "id": "wedge-suitcase",
          "object": "suitcase",
          "when": [{ "object": "suitcase", "state": "parked" }],
          "then": [{ "object": "suitcase", "state": "stopped" }],
          "caption": "You wedge the suitcase under a seat."
        },
        {
          "id": "catch-suitcase",
          "object": "suitcase",
          "when": [{ "object": "suitcase", "state": "rolling" }],
          "then": [{ "object": "suitcase", "state": "stopped" }],
          "caption": "You catch the suitcase by the handle."
        },
        {
          "id": "force-door-shut",
          "object": "door",
          "when": [{ "object": "door", "state": "jammed_open" }],
          "then": [{ "object": "door", "state": "closed" }],
          "caption": "You force the door shut."
        },
        {
          "id": "pet-dog",
          "object": "dog",
          "when": [{ "object": "dog", "state": "sniffing" }],
          "then": [{ "object": "dog", "state": "calm" }],
          "caption": "You scratch the dog behind the ears. It settles at your feet."
        }
      ],
      "triggers": [
        {
          "id": "dog-wakes",
          "at": 1,
          "when": [{ "object": "dog", "state": "asleep" }],
          "then": [{ "object": "dog", "state": "sniffing" }],
          "caption": "The dog wakes up and smells fresh air."
        },
        {
          "id": "driver-looks-away",
          "at": 2,
          "when": [{ "object": "driver", "state": "sipping" }],
          "then": [{ "object": "driver", "state": "distracted" }],
          "caption": "The driver's phone buzzes. The driver looks down."
        },
        {
          "id": "suitcase-rolls",
          "at": 3,
          "when": [{ "object": "suitcase", "state": "parked" }],
          "then": [{ "object": "suitcase", "state": "rolling" }],
          "caption": "A suitcase starts rolling down the aisle."
        },
        {
          "id": "tram-speeds-up",
          "after": { "object": "driver", "state": "distracted", "delay": 4 },
          "then": [{ "object": "tram", "state": "speeding" }],
          "caption": "Nobody slows down for the bend."
        },
        {
          "id": "suitcase-hits-door",
          "after": { "object": "suitcase", "state": "rolling", "delay": 3 },
          "when": [{ "object": "door", "state": "closed" }],
          "then": [
            { "object": "door", "state": "jammed_open" },
            { "object": "suitcase", "state": "stopped" }
          ],
          "caption": "The suitcase slams into the door and jams it open."
        },
        {
          "id": "suitcase-hits-driver",
          "after": { "object": "suitcase", "state": "flying", "delay": 1 },
          "then": [{ "object": "tram", "state": "derailed" }],
          "caption": "The suitcase lands in the driver's cabin."
        },
        {
          "id": "tram-derails",
          "after": { "object": "tram", "state": "speeding", "delay": 2 },
          "then": [{ "object": "tram", "state": "derailed" }],
          "caption": "The tram takes the bend far too fast."
        },
        {
          "id": "dog-bolts",
          "after": { "object": "door", "state": "jammed_open", "delay": 3 },
          "when": [{ "object": "dog", "state": "sniffing" }],
          "then": [{ "object": "dog", "state": "gone" }],
          "caption": "The dog sees the open door and bolts."
        }
      ],
      "disasters": [
        {
          "id": "derailment",
          "when": [{ "object": "tram", "state": "derailed" }],
          "caption": "The tram leaves the tracks. You will not be home on time."
        },
        {
          "id": "lost-dog",
          "when": [{ "object": "dog", "state": "gone" }],
          "caption": "The dog is gone, and its owner is looking at you."
        }
      ]
    }