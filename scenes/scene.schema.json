{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://10-saniye.local/scene.schema.json",
  "title": "10 Saniye scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "title", "intro", "durationSeconds", "maxTouches", "grid", "objects", "touches", "triggers", "disasters"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "intro": { "type": "string", "minLength": 1, "maxLength": 200 },
    "durationSeconds": { "const": 10 },
    "maxTouches": { "type": "integer", "minimum": 1, "maximum": 3 },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": { "type": "integer", "minimum": 1, "maximum": 12 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 12 }
      }
    },
    "objects": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/sceneObject" } },
    "touches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/touchRule" } },
    "triggers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/trigger" } },
    "disasters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/disaster" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$" },
    "caption": { "type": "string", "minLength": 1, "maxLength": 120 },
    "stateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object", "state"],
      "properties": {
        "object": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/id" }
      }
    },
    "stateRefs": { "type": "array", "items": { "$ref": "#/$defs/stateRef" } },
    "sceneObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "position", "initialState", "states"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 }
          }
        },
        "initialState": { "$ref": "#/$defs/id" },
        "states": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["emoji"],
            "properties": { "emoji": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "touchRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object", "then"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "object": { "$ref": "#/$defs/id" },
        "when": { "$ref": "#/$defs/stateRefs" },
        "then": { "allOf": [{ "$ref": "#/$defs/stateRefs" }, { "minItems": 1 }] },
        "caption": { "$ref": "#/$defs/caption" }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "then"],
      "oneOf": [{ "required": ["at"] }, { "required": ["after"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "at": { "type": "integer", "minimum": 1, "maximum": 10 },
        "after": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object", "state", "delay"],
          "properties": {
            "object": { "$ref": "#/$defs/id" },
            "state": { "$ref": "#/$defs/id" },
            "delay": { "type": "integer", "minimum": 1, "maximum": 10 }
          }
        },
        "when": { "$ref": "#/$defs/stateRefs" },
        "then": { "allOf": [{ "$ref": "#/$defs/stateRefs" }, { "minItems": 1 }] },
        "caption": { "$ref": "#/$defs/caption" }
      }
    },
    "disaster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "caption"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "when": { "allOf": [{ "$ref": "#/$defs/stateRefs" }, { "minItems": 1 }] },
        "caption": { "$ref": "#/$defs/caption" }
      }
    }
  }
}
